{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "handoff.schema.json",
	"title": "Handoff",
	"description": "Frozen implementation brief. Issue and download are representations of the same revision.",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"handoffId",
		"handoffRevision",
		"investigationId",
		"investigationRevision",
		"objective",
		"targetRepository",
		"constraints",
		"evidence",
		"acceptance",
		"audience",
		"bodyMarkdown",
		"bodyHash",
		"preparedAt",
		"publication"
	],
	"properties": {
		"handoffId": {
			"$ref": "common.schema.json#/$defs/Id"
		},
		"handoffRevision": {
			"type": "integer",
			"minimum": 1
		},
		"investigationId": {
			"$ref": "common.schema.json#/$defs/Id"
		},
		"investigationRevision": {
			"$ref": "common.schema.json#/$defs/Revision"
		},
		"objective": {
			"$ref": "common.schema.json#/$defs/LongText"
		},
		"targetRepository": {
			"title": "HandoffTarget",
			"type": "object",
			"additionalProperties": false,
			"required": ["repositoryId", "baseCommit", "hashAlgorithm"],
			"properties": {
				"repositoryId": {
					"$ref": "common.schema.json#/$defs/Id"
				},
				"baseCommit": {
					"$ref": "common.schema.json#/$defs/CommitId"
				},
				"hashAlgorithm": {
					"$ref": "common.schema.json#/$defs/HashAlgorithm"
				}
			},
			"if": {
				"type": "object",
				"required": ["hashAlgorithm"],
				"properties": {
					"hashAlgorithm": {
						"const": "sha1"
					}
				}
			},
			"then": {
				"type": "object",
				"required": ["baseCommit"],
				"properties": {
					"baseCommit": {
						"type": "string",
						"pattern": "^[0-9a-f]{40}$"
					}
				}
			},
			"else": {
				"type": "object",
				"required": ["baseCommit"],
				"properties": {
					"baseCommit": {
						"type": "string",
						"pattern": "^[0-9a-f]{64}$"
					}
				}
			}
		},
		"constraints": {
			"type": "array",
			"maxItems": 32,
			"items": {
				"title": "HandoffConstraint",
				"type": "object",
				"additionalProperties": false,
				"required": ["statement", "decisionId"],
				"properties": {
					"statement": {
						"$ref": "common.schema.json#/$defs/LongText"
					},
					"decisionId": {
						"$ref": "common.schema.json#/$defs/Id"
					},
					"kind": {
						"enum": [
							"constraint",
							"rejected_approach",
							"correction",
							"acceptance"
						],
						"description": "Mirrors Decision.kind (rejection is rendered as rejected_approach). Acceptance decisions are constraints on the specialist too: they say what the human already agreed to."
					},
					"category": {
						"$ref": "common.schema.json#/$defs/DecisionCategory"
					}
				}
			}
		},
		"evidence": {
			"type": "array",
			"maxItems": 32,
			"items": {
				"title": "HandoffEvidence",
				"type": "object",
				"additionalProperties": false,
				"required": ["ref", "note"],
				"properties": {
					"ref": {
						"$ref": "source-ref.schema.json"
					},
					"note": {
						"$ref": "common.schema.json#/$defs/ShortText"
					}
				}
			}
		},
		"likelyFiles": {
			"type": "array",
			"maxItems": 32,
			"items": {
				"type": "string",
				"maxLength": 1024
			},
			"description": "Suggestion only, not a verified dependency list."
		},
		"acceptance": {
			"type": "array",
			"minItems": 1,
			"maxItems": 32,
			"items": {
				"title": "AcceptanceItem",
				"type": "object",
				"additionalProperties": false,
				"required": ["behavior", "status"],
				"properties": {
					"behavior": {
						"$ref": "common.schema.json#/$defs/ShortText"
					},
					"status": {
						"enum": ["not_run", "specialist_reported", "ci_reported"]
					}
				}
			}
		},
		"allowedScope": {
			"$ref": "common.schema.json#/$defs/LongText"
		},
		"excludedChanges": {
			"$ref": "common.schema.json#/$defs/LongText"
		},
		"uncertainties": {
			"type": "array",
			"maxItems": 16,
			"items": {
				"$ref": "common.schema.json#/$defs/ShortText"
			}
		},
		"audience": {
			"enum": ["private_download", "private_issue", "public_issue"]
		},
		"bodyMarkdown": {
			"type": "string",
			"minLength": 1,
			"maxLength": 65536
		},
		"bodyHash": {
			"$ref": "common.schema.json#/$defs/Sha256"
		},
		"preparedAt": {
			"$ref": "common.schema.json#/$defs/TimestampMs"
		},
		"publication": {
			"title": "Publication",
			"type": "object",
			"additionalProperties": false,
			"required": ["status"],
			"properties": {
				"status": {
					"enum": [
						"prepared",
						"exported",
						"approved",
						"published",
						"outcome_unknown"
					]
				},
				"issueUrl": {
					"type": "string",
					"maxLength": 512,
					"pattern": "^https://[^\\s/?#]+(?:[/?#][^\\s]*)?$"
				},
				"receiptId": {
					"$ref": "common.schema.json#/$defs/Id"
				}
			}
		}
	}
}

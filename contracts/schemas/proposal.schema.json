{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "proposal.schema.json",
	"title": "Proposal",
	"description": "Tentative, evidence-backed comparison from a host or backend driver. Accepted = shape, references and authority validated, not that the reasoning is proven.",
	"type": "object",
	"additionalProperties": false,
	"required": ["investigationId", "baseRevision", "claims"],
	"properties": {
		"investigationId": {
			"$ref": "common.schema.json#/$defs/Id"
		},
		"runId": {
			"$ref": "common.schema.json#/$defs/Id"
		},
		"baseRevision": {
			"$ref": "common.schema.json#/$defs/Revision"
		},
		"claims": {
			"type": "array",
			"minItems": 1,
			"maxItems": 16,
			"items": {
				"title": "Claim",
				"type": "object",
				"additionalProperties": false,
				"required": ["statement", "evidenceClass", "refs"],
				"properties": {
					"statement": {
						"$ref": "common.schema.json#/$defs/LongText"
					},
					"evidenceClass": {
						"enum": [
							"model_hypothesis",
							"observed_literal",
							"observed_structural",
							"observed_history"
						]
					},
					"refs": {
						"type": "array",
						"minItems": 1,
						"maxItems": 8,
						"items": {
							"$ref": "source-ref.schema.json"
						}
					},
					"unknowns": {
						"$ref": "common.schema.json#/$defs/ClaimUnknowns"
					}
				}
			}
		},
		"composition": {
			"$ref": "composition.schema.json"
		}
	}
}

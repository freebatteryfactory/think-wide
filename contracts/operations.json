{
	"contractVersion": "0.7.0",
	"note": "Canonical operation registry. HTTP, MCP and any CLI dispatch through the same handler and policy. A new operation is NOT agent-exposed unless 'mcp' is listed here. Operations that return the result envelope declare envelopeKind; the operation pipeline rejects a response whose kind differs. An optional handler, '<convexModule>:<exportName>', binds an operation to the Convex function that implements it; an operation without one is unimplemented. Adapters dispatch through this binding rather than restating it. uiTemplates declares the static, read-only MCP Apps views (ui:// resources) the MCP adapter serves; an MCP-exposed operation may bind one with ui.template, and codegen emits the tool _meta and the resource descriptors. A template is presentation only: it carries no data and no authority, and every value it shows arrives through the authorized tool call.",
	"uiTemplates": {
		"investigation": {
			"uri": "ui://think-wide/investigation-v1.html",
			"title": "Investigation",
			"description": "Read-only view of one investigation: question, status, revision, snapshots in scope, human decisions, and findings with their exact evidence references"
		}
	},
	"operations": [
		{
			"operationId": "getCapabilities",
			"handler": "capabilities:getCapabilities",
			"summary": "Actual enabled modes, limits, versions, integration status",
			"request": "requests.schema.json#/$defs/GetCapabilitiesRequest",
			"response": "capabilities.schema.json",
			"effect": "read",
			"exposure": ["http", "mcp"],
			"approval": false,
			"profile": "required",
			"ticket": "T08"
		},
		{
			"operationId": "listProjects",
			"summary": "Authorized projects with compact snapshot and coverage records",
			"request": "requests.schema.json#/$defs/ListProjectsRequest",
			"response": "envelope.schema.json",
			"envelopeKind": "projects",
			"entries": "project.schema.json",
			"effect": "read",
			"handler": "projects:listProjects",
			"exposure": ["http", "mcp"],
			"approval": false,
			"profile": "required",
			"ticket": "T05"
		},
		{
			"operationId": "claimDemoAccess",
			"summary": "Claim reader access to the operator-published public demo catalog",
			"request": "requests.schema.json#/$defs/ClaimDemoAccessRequest",
			"response": "envelope.schema.json",
			"envelopeKind": "projects",
			"entries": "project.schema.json",
			"effect": "state",
			"handler": "catalog:claimDemoAccess",
			"exposure": ["http", "mcp"],
			"approval": false,
			"profile": "required",
			"ticket": "F"
		},
		{
			"operationId": "browseSnapshot",
			"summary": "Direct children of a tree node with metadata and exact source handles",
			"request": "requests.schema.json#/$defs/BrowseSnapshotRequest",
			"response": "envelope.schema.json",
			"envelopeKind": "tree",
			"entries": "snapshot-entry.schema.json",
			"effect": "read",
			"handler": "snapshots:browseSnapshot",
			"exposure": ["http", "mcp"],
			"approval": false,
			"profile": "required",
			"ticket": "T05"
		},
		{
			"operationId": "readSource",
			"summary": "Exact bytes for an authorized source reference, with range and digest",
			"request": "requests.schema.json#/$defs/ReadSourceRequest",
			"response": "evidence.schema.json",
			"effect": "read",
			"handler": "sourceCache:readSource",
			"exposure": ["http", "mcp"],
			"approval": false,
			"profile": "required",
			"ticket": "T05"
		},
		{
			"operationId": "searchSources",
			"summary": "Literal or reviewed structural search over a fixed snapshot set",
			"request": "requests.schema.json#/$defs/SearchSourcesRequest",
			"response": "envelope.schema.json",
			"envelopeKind": "search",
			"entries": "finding.schema.json",
			"effect": "read",
			"exposure": ["http", "mcp"],
			"approval": false,
			"profile": "required",
			"ticket": "T07"
		},
		{
			"operationId": "readHistory",
			"summary": "Bounded commit records for a snapshot or verified path",
			"request": "requests.schema.json#/$defs/ReadHistoryRequest",
			"response": "envelope.schema.json",
			"envelopeKind": "history",
			"entries": "commit-record.schema.json",
			"effect": "read",
			"handler": "snapshots:readHistory",
			"exposure": ["http", "mcp"],
			"approval": false,
			"profile": "required",
			"ticket": "T05"
		},
		{
			"operationId": "readGuidance",
			"summary": "Trusted recipe catalog, or one recipe's full guidance",
			"request": "requests.schema.json#/$defs/ReadGuidanceRequest",
			"response": "envelope.schema.json",
			"envelopeKind": "guidance",
			"entries": "recipe.schema.json",
			"effect": "read",
			"exposure": ["http", "mcp"],
			"approval": false,
			"profile": "required",
			"ticket": "T07"
		},
		{
			"operationId": "openInvestigation",
			"summary": "Create a durable investigation over selected snapshots",
			"request": "requests.schema.json#/$defs/OpenInvestigationRequest",
			"response": "investigation.schema.json",
			"effect": "state",
			"handler": "investigations:openInvestigation",
			"exposure": ["http", "mcp"],
			"approval": false,
			"profile": "required",
			"ticket": "T06"
		},
		{
			"operationId": "readInvestigation",
			"summary": "Accepted findings, decisions, revision and run status",
			"request": "requests.schema.json#/$defs/ReadInvestigationRequest",
			"response": "investigation.schema.json",
			"effect": "read",
			"handler": "investigations:readInvestigation",
			"ui": { "template": "investigation" },
			"exposure": ["http", "mcp"],
			"approval": false,
			"profile": "required",
			"ticket": "T06"
		},
		{
			"operationId": "recordDecision",
			"summary": "Record a human correction, constraint or rejection; advances the revision",
			"request": "requests.schema.json#/$defs/RecordDecisionRequest",
			"response": "decision.schema.json",
			"effect": "state",
			"handler": "decisions:recordDecision",
			"exposure": ["http", "mcp"],
			"approval": false,
			"profile": "required",
			"ticket": "T06"
		},
		{
			"operationId": "submitProposal",
			"summary": "Submit a tentative evidence-backed comparison against a base revision",
			"request": "requests.schema.json#/$defs/SubmitProposalRequest",
			"response": "investigation.schema.json",
			"effect": "state",
			"exposure": ["http", "mcp"],
			"approval": false,
			"profile": "required",
			"ticket": "T10",
			"handler": "proposals:submitProposal"
		},
		{
			"operationId": "beginHostRun",
			"summary": "Admit a host reasoning run before analysis; no model call is dispatched",
			"request": "requests.schema.json#/$defs/RequestAnalysisRequest",
			"response": "run.schema.json",
			"effect": "state",
			"handler": "runs:beginHostRun",
			"exposure": ["http", "mcp"],
			"approval": false,
			"profile": "required",
			"ticket": "T10"
		},
		{
			"operationId": "requestAnalysis",
			"summary": "Admit one bounded backend reasoning run",
			"request": "requests.schema.json#/$defs/RequestAnalysisRequest",
			"response": "run.schema.json",
			"effect": "state",
			"handler": "runs:admitRun",
			"exposure": ["http"],
			"approval": false,
			"profile": "conditional",
			"ticket": "T10"
		},
		{
			"operationId": "getRun",
			"summary": "Current authorized run status",
			"request": "requests.schema.json#/$defs/GetRunRequest",
			"response": "run.schema.json",
			"effect": "read",
			"handler": "runs:getRun",
			"exposure": ["http", "mcp"],
			"approval": false,
			"profile": "conditional",
			"ticket": "T10"
		},
		{
			"operationId": "cancelRun",
			"summary": "Fence a run; does not undo an already dispatched external effect",
			"request": "requests.schema.json#/$defs/CancelRunRequest",
			"response": "run.schema.json",
			"effect": "state",
			"handler": "runs:cancelRun",
			"exposure": ["http", "mcp"],
			"approval": false,
			"profile": "conditional",
			"ticket": "T10"
		},
		{
			"operationId": "prepareHandoff",
			"summary": "Freeze an implementation brief revision with body hash",
			"request": "requests.schema.json#/$defs/PrepareHandoffRequest",
			"response": "handoff-summary.schema.json",
			"effect": "state",
			"exposure": ["http", "mcp"],
			"approval": false,
			"profile": "required",
			"ticket": "T09",
			"handler": "handoffs:prepareHandoff"
		},
		{
			"operationId": "readHandoff",
			"summary": "Exact reviewed brief text plus structured references",
			"request": "requests.schema.json#/$defs/ReadHandoffRequest",
			"response": "handoff-read.schema.json",
			"effect": "read",
			"exposure": ["http", "mcp"],
			"approval": false,
			"profile": "required",
			"ticket": "T09",
			"handler": "handoffs:readHandoff"
		}
	],
	"deferred": [
		"publishIssue (I03, external effect, human approval binding)",
		"refreshOutcome (I05)"
	]
}

{
	admin off
	servers {
		protocols h1 h2
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
}

think-wide.fbf.systems {
	import security_headers
	# TanStack Start currently emits inline hydration scripts. Replace unsafe-inline
	# with application-generated nonces when the app supplies them. No unsafe-eval.
	header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://convex.think-wide.fbf.systems wss://convex.think-wide.fbf.systems"
	encode zstd gzip
	reverse_proxy app:3000
}

convex.think-wide.fbf.systems {
	import security_headers
	# Caddy 2.11.2 reverse_proxy handles WebSocket upgrade automatically.
	# Only the API listener is routed; dashboard/actions/admin credentials stay private.
	reverse_proxy backend:3210
}

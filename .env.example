# Copy to .env.local (gitignored). Never commit real values. Never paste these in issues or chat.

# --- mode: "local-demo" = loopback only, synthetic/public data. "connected" = real auth. ---
THINK_WIDE_MODE=local-demo

# --- self-hosted Convex (infra/docker-compose.yml) ---
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
# Generate: docker compose -f infra/docker-compose.yml exec backend ./generate_admin_key.sh
# Server/CLI only. Must never be imported by anything under src/routes or src/components.
CONVEX_SELF_HOSTED_ADMIN_KEY=
VITE_CONVEX_URL=http://127.0.0.1:3210

# --- identity mode (ticket I01): "workos" | "none". Anything else means "none". ---
# Both are mode NAMES, never credentials. Never put a token, key, principal or secret in a
# VITE_* variable: Vite inlines VITE_* into the public browser bundle at BUILD time.
# "none": bare Convex provider, handlers answer `unauthenticated`, no sign-in link, and the
# server does not install the AuthKit middleware (so it boots without any WORKOS_* value).
# "workos": set BOTH. The build one mounts AuthKit + ConvexProviderWithAuth in the browser;
# the runtime one installs the AuthKit middleware, which then REQUIRES all four WORKOS_*.
VITE_THINK_WIDE_IDENTITY=none
THINK_WIDE_IDENTITY=none

# --- WorkOS AuthKit (ticket I01) ---
# All server-side. WORKOS_CLIENT_ID must ALSO be set on the Convex deployment (not here by
# the app: `convex env set`, operator only) for convex/auth.config.ts to trust the issuer.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Must match BOTH the registered WorkOS redirect URI and src/routes/api/auth/callback.tsx.
# Corrected 2026-09-20: the AuthKit TanStack integration serves /api/auth/callback,
# not /callback. workos doctor flags the mismatch as CALLBACK_ROUTE_MISSING.
WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Session cookie encryption key, at least 32 characters. Generate it in a password
# manager: this is secret material with its own custody row, not a setting.
WORKOS_COOKIE_PASSWORD=
# Audience / resource indicator the MCP endpoint accepts. Must match convex/auth.config.ts.
MCP_RESOURCE_URL=

# --- backend reasoning driver (ticket T10), only if backend-directed mode is admitted ---
ANTHROPIC_API_KEY=

# --- GitHub App (tickets I02/I03, optional) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
